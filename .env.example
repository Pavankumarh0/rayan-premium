# ---------------------------------------------------------------------------
# Local development environment. Copy from .env.example and fill in.
# This file is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# SQLite by default. For MySQL/MariaDB see README "Switching to MySQL".
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-32-character-random-string"

# Public base URL. Also editable in the admin under Settings > SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed account for `npm run db:seed`. Change the password before any deployment.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe12345"
SEED_ADMIN_NAME="Site Administrator"
