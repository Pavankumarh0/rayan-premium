# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The app reads DATABASE_URL; the aliases below
# exist because some hosts inject their own name for the same value.
#
# Use sslmode=verify-full rather than sslmode=require: node-postgres currently
# treats "require" as "verify-full", but a future major release will weaken it
# to libpq semantics, which skip certificate verification.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
PRISMA_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"

# Signs the admin session cookie. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-32-character-random-string"

# Public base URL. Also editable in the admin under Settings > SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed account for `npm run db:seed`. Change the password before any deployment.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe12345"
SEED_ADMIN_NAME="Site Administrator"
